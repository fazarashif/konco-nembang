{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Konco Nembang",
  "version": "0.1.0",
  "identifier": "com.konconembang.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "Konco Nembang Overlay",
        "width": 900,
        "height": 170,
        "minWidth": 480,
        "minHeight": 96,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Faza",
    "copyright": "Copyright © 2026 Faza",
    "homepage": "https://github.com/fazarashif/konco-nembang",
    "category": "Music",
    "shortDescription": "Transparent synced-lyrics overlay for Windows",
    "longDescription": "Konco Nembang shows synced lyrics for what you are playing in Spotify, YouTube Music or YouTube as a transparent, click-through overlay that stays out of the way while you work or game.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer/header.bmp",
        "sidebarImage": "icons/installer/sidebar.bmp",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBQUVCMjlFOEIzMDA1NzkKUldSNUJUQ0xuckt1MmdGYzJPZDM5OWJKRFBXT1NmVWtXMEJWbGErMnJVRU11Y2xBaExLbjFiL2EK",
      "endpoints": ["https://github.com/fazarashif/konco-nembang/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
